{
  "name": "em-dasher",
  "version": "0.1.0",
  "description": "Replaces --- with an em dash as you type.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production"
  },
